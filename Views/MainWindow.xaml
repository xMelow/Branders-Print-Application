<Window x:Class="Branders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Branders"
        xmlns:viewmodels="clr-namespace:Branders.Viewmodels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Width="120">
            <Button Content="Import Excel"
                    Command="{Binding ImportExcelCommand}"
                    Background="#008896"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sheets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#CCC"
                                    BorderThickness="1"
                                    Margin="0,0,15,0"
                                    Padding="10"
                                    CornerRadius="4">

                                <StackPanel Width="300">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Margin="0,0,0,5"/>
                                    
                                    <DataGrid ItemsSource="{Binding View}"
                                              AutoGenerateColumns="True"
                                              SelectionMode="Extended"
                                              SelectionUnit="FullRow"
                                              CanUserAddRows="False"
                                              Height="200" />

                                    <Button Content="Print selectie"
                                            Command="{Binding SheetPrintSelectedCommand}"
                                            Margin="0,10,0,0"
                                            Width="120"/>
                                    
                                    <Button Content="Print alles"
                                            Command="{Binding SheetPrintAllCommand}"
                                            Margin="0,10,0,0"
                                            Width="120"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>
